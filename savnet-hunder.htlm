<!doctype html>
<html lang="no">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Savnede hunder – Hundene Våre</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{
  --green:#07563f;--green2:#0d7657;--bg:#f3f7f4;--card:#fff;--text:#17221c;
  --muted:#66736b;--red:#cf2940;--line:#e0e9e3;--soft:#edf5f0;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);font-family:system-ui,-apple-system,Segoe UI,Arial,sans-serif;color:var(--text)}
header{
  background:linear-gradient(135deg,#a91f32,var(--red));
  color:white;text-align:center;padding:24px 16px 28px;
}
header h1{margin:0;font-size:1.6rem}
header p{margin:7px 0 0;opacity:.95}
main{max-width:1100px;margin:auto;padding:18px 14px 55px}
.top{
  background:#fff;border:1px solid var(--line);border-radius:20px;padding:18px;
  margin-bottom:17px;box-shadow:0 8px 28px #00000012;
}
.searchrow{display:grid;grid-template-columns:1fr auto;gap:10px}
input{
  width:100%;padding:13px;border:1px solid #cbd7cf;border-radius:11px;font:inherit;
}
button,a.btn{
  border:0;border-radius:12px;padding:13px 16px;font-weight:850;font-size:15px;
  text-decoration:none;display:inline-block;text-align:center;cursor:pointer;
}
.green{background:var(--green);color:#fff}
.outline{background:#fff;color:var(--green);border:2px solid var(--green)}
.grid{
  display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;
}
.card{
  background:var(--card);border:1px solid var(--line);border-radius:20px;
  overflow:hidden;box-shadow:0 8px 28px #00000012;
}
.photo{
  width:100%;height:240px;object-fit:cover;background:#edf4ef;display:block;
}
.placeholder{
  width:100%;height:240px;background:#edf4ef;display:grid;place-items:center;font-size:72px;
}
.content{padding:17px}
.badge{
  display:inline-block;background:#ffe3e7;color:#b0182c;border-radius:999px;
  padding:7px 11px;font-weight:900;font-size:.86rem;margin-bottom:7px;
}
h2{margin:4px 0 4px;font-size:1.35rem}
.muted{color:var(--muted);line-height:1.45}
.code{
  display:inline-block;background:#f6faf7;border:1px solid #dfe9e2;
  padding:7px 10px;border-radius:10px;font-size:.9rem;font-weight:800;margin:8px 0 12px;
}
.actions{display:grid;grid-template-columns:1fr;gap:8px}
.empty{
  background:#fff;border:1px solid var(--line);border-radius:20px;padding:35px 20px;
  text-align:center;box-shadow:0 8px 28px #00000012;
}
.small{font-size:.88rem;color:var(--muted)}
.count{font-weight:900;color:var(--red)}
@media(max-width:850px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:580px){
  .grid{grid-template-columns:1fr}
  .photo,.placeholder{height:230px}
  .searchrow{grid-template-columns:1fr}
  header{padding:20px 12px}
}

.top-nav{
  max-width:1100px;
  margin:14px auto 0;
  padding:0 14px;
  display:flex;
  gap:10px;
  flex-wrap:wrap;
}
.top-nav a{
  flex:1 1 220px;
  text-decoration:none;
  text-align:center;
  padding:12px 16px;
  border-radius:14px;
  font-weight:900;
  font-size:15px;
}
.top-nav .home{
  background:#07563f;
  color:white;
}
.top-nav .back{
  background:white;
  color:#07563f;
  border:2px solid #07563f;
}
</style>
</head>
<body>
<header>
  <h1>🚨 Savnede hunder</h1>
  <p>Hundene Våre – Digital Hunde-ID</p>
</header>

<div class="top-nav">
  <a class="home" href="index.html">🏠 Til forsiden</a>
  <a class="back" href="registrer-hunde-id-test.html">← Tilbake til registrering</a>
</div>


<main>
<div class="top">
  <div class="searchrow">
    <input id="search" placeholder="🔎 Søk på navn, rase eller Hunde-ID" oninput="render()">
    <button class="green" onclick="loadMissing()">Oppdater</button>
  </div>
  <p class="small" style="margin-bottom:0">
    Viser hunder som eieren har meldt savnet. Når hunden meldes trygg igjen, forsvinner den automatisk fra denne siden.
  </p>
</div>

<div id="status" class="top">Henter savnede hunder …</div>
<div id="list" class="grid"></div>
<div id="empty" class="empty" style="display:none">
  <div style="font-size:58px">🐶</div>
  <h2>Ingen savnede hunder akkurat nå</h2>
  <p class="muted">Det er gode nyheter.</p>
</div>
</main>

<script>
const sb=supabase.createClient(
  "https://kxudiviidwwwclbzgdyx.supabase.co",
  "sb_publishable_EaSgrgWqXKnaRRRkKparWA_ZmmRG8QH"
);

let dogs=[];

function esc(v){
  const d=document.createElement("div");
  d.textContent=v||"";
  return d.innerHTML;
}

function formatTime(v){
  try{
    return new Date(v).toLocaleString("no-NO",{
      day:"2-digit",month:"2-digit",year:"numeric",hour:"2-digit",minute:"2-digit"
    });
  }catch{return ""}
}

async function loadMissing(){
  document.getElementById("status").style.display="block";
  document.getElementById("status").textContent="Henter savnede hunder …";

  const {data,error}=await sb.rpc("get_missing_dogs");

  if(error){
    document.getElementById("status").innerHTML=
      '<b>Feil:</b> '+esc(error.message);
    return;
  }

  dogs=data||[];
  render();
}

function render(){
  const q=document.getElementById("search").value.trim().toLowerCase();
  const filtered=dogs.filter(d=>{
    const text=[d.dog_name,d.breed,d.sex,d.color,d.dog_code].filter(Boolean).join(" ").toLowerCase();
    return text.includes(q);
  });

  const status=document.getElementById("status");
  const list=document.getElementById("list");
  const empty=document.getElementById("empty");

  if(!dogs.length){
    status.style.display="none";
    list.innerHTML="";
    empty.style.display="block";
    return;
  }

  empty.style.display="none";
  status.style.display="block";
  status.innerHTML='<span class="count">'+filtered.length+'</span> savnet'+
    (filtered.length===1?' hund':'e hunder')+
    (q?' passer søket.':' registrert.');

  if(!filtered.length){
    list.innerHTML='<div class="empty" style="grid-column:1/-1"><h2>Ingen treff</h2><p class="muted">Prøv et annet navn eller en annen rase.</p></div>';
    return;
  }

  list.innerHTML=filtered.map(d=>{
    const url="https://www.xn--hundenevre-85a.com/hunde-id.html?id="+encodeURIComponent(d.dog_code);
    const img=d.photo_url
      ? '<img class="photo" src="'+esc(d.photo_url)+'" alt="'+esc(d.dog_name)+'">'
      : '<div class="placeholder">🐶</div>';

    return `
      <article class="card">
        ${img}
        <div class="content">
          <div class="badge">🚨 SAVNET</div>
          <h2>${esc(d.dog_name)} 🐾</h2>
          <p class="muted">${[d.breed,d.sex,d.color].filter(Boolean).map(esc).join(" · ")}</p>
          <div class="code">ID: ${esc(d.dog_code)}</div>
          <p class="small">Meldt/oppdatert: ${formatTime(d.updated_at)}</p>
          <div class="actions">
            <a class="btn green" href="${url}">🐾 SE HUND / JEG HAR FUNNET DEN</a>
          </div>
        </div>
      </article>`;
  }).join("");
}

loadMissing();
</script>
</body>
</html>
